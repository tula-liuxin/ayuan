{
  "name": "ayuan",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "description": "阿源：跨设备共享记忆与状态的 DSH 助手。独立浮框、真实 Agent 会话、可追溯记忆和有来源的页面上下文。",
  "exports": {
    ".": "./index.js",
    "./memory": "./memory.js",
    "./status": "./status.js",
    "./context": "./context.js",
    "./tools": "./tools.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "memory.js",
    "status.js",
    "context.js",
    "tools.js",
    "legacy.js",
    "agent.js",
    "page-token.js",
    "cordis.patch.yml",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "THIRD-PARTY-NOTICES.txt",
    "CONTRACT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "ayuan",
    "assistant",
    "memory",
    "agent"
  ],
  "author": {
    "name": "leo",
    "url": "https://github.com/tula-liuxin"
  },
  "license": "MIT"
}
